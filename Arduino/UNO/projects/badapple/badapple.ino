const uint16_t MELODY_LENGTH = sizeof(melody) / sizeof(melody[0]);

void setup() {
  pinMode(TONE_PIN, OUTPUT);
}

void playNote(uint16_t frequency) {
  if (frequency == 0) {
    delay(LONG_DELAY);
  }
  else if(frequency == 1) {
    delay(SHORTER_DELAY);
  }
  else {
    tone(TONE_PIN, frequency, NOTE_DURATION);
    delay(SHORT_DELAY);
  }
}

void midi() {
  for (uint16_t i = 0; i < MELODY_LENGTH; i++) {
    uint16_t freq = pgm_read_word(&melody[i]);
    playNote(freq);
  }
}

void loop() {
  midi();
}
